#!/usr/bin/env bash
# Screenshots of the UI tests that show a PR's change.
#
#   ui-screenshots tests <test-dir> <test-target>
#     Print the `-only-testing:` arguments, space-separated, or nothing, for:
#       - each XCTestCase subclass in a Swift file under <test-dir> that the PR
#         adds or changes. Run in a `pull_request` checkout of the merge commit,
#         fetched with depth 2: its first parent is the base branch, so
#         `HEAD^1..HEAD` is exactly the PR's change.
#       - each test ID in a `<!-- ui-screenshots: … -->` marker in $PR_BODY (the
#         PR description), so a PR can name tests it does not change, such as
#         an existing test that goes to the screen a fix changes. IDs are
#         `[<target>/]<class>[/<method>]`, separated by spaces, commas or
#         newlines; the target is added when it is left out. A two-part ID is
#         `<class>/<method>` when its second part starts with `test` (XCTest
#         runs only methods named so), and `<target>/<class>` otherwise.
#
#   ui-screenshots destination
#     Print an xcodebuild destination for the newest available iPhone
#     simulator.
#
#   ui-screenshots publish <xcresult> <pr-number> <sha> <tests-passed> <comment-file>
#     Export the result bundle's PNG attachments, commit them to the
#     `ui-screenshots` branch under pr-<n>/<sha7>/, and write a PR comment that
#     shows them to <comment-file>. Writes nothing when there are no PNGs. The
#     branch is an orphan that holds only these images; images are linked with
#     `blob/…?raw=true`, which a private repo serves to signed-in viewers who
#     can read it.
#
# Needs GH_TOKEN with contents: write (publish), GITHUB_REPOSITORY,
# GITHUB_SERVER_URL and GITHUB_RUN_ID.

set -euo pipefail

BRANCH=ui-screenshots

tests() {
  local dir="$1" target="$2" file classes=""
  while IFS= read -r file; do
    [ -n "$file" ] || continue
    classes+=" $(sed -nE 's/^[[:space:]]*(final[[:space:]]+)?(public[[:space:]]+|internal[[:space:]]+)?class[[:space:]]+([A-Za-z_][A-Za-z0-9_]*)[[:space:]]*:[[:space:]]*XCTestCase.*/\3/p' "$file" | tr '\n' ' ')"
  done < <(git diff --name-only --diff-filter=AMR HEAD^1 HEAD -- "$dir" | grep '\.swift$' || true)

  local ids id
  ids=$(printf '%s\n' $classes)
  # Test IDs named in the PR description's marker. Keep only the characters a
  # test ID can have: the description is text anyone with access can edit.
  local named
  named=$(printf '%s' "${PR_BODY:-}" \
    | perl -0777 -ne 'print "$1\n" while /<!--\s*ui-screenshots:(.*?)-->/gs' \
    | tr ', \t\r' '\n\n\n\n' | sed 's/()$//' | grep -E '^[A-Za-z_][A-Za-z0-9_/]*$' || true)
  for id in $named; do
    case "$id" in
      */*/*) id="${id#*/}" ;;   # target/class/method
      */test*) ;;               # class/method
      */*) id="${id#*/}" ;;     # target/class
    esac
    ids+=$'\n'"$id"
  done

  local args=""
  for id in $(printf '%s\n' "$ids" | grep -v '^$' | sort -u); do
    args+=" -only-testing:$target/$id"
  done
  printf '%s' "${args# }"
}

destination() {
  local udid
  udid=$(xcrun simctl list devices available -j | jq -r '
    [.devices | to_entries[] | select(.key | test("iOS")) | .value[] | select(.name | startswith("iPhone"))]
    | last | .udid // empty')
  [ -n "$udid" ] || { echo "No available iPhone simulator." >&2; exit 1; }
  printf 'id=%s' "$udid"
}

publish() {
  local xcresult="$1" pr="$2" sha="$3" passed="$4" comment="$5"
  local export_dir dest
  export_dir=$(mktemp -d)
  xcrun xcresulttool export attachments --path "$xcresult" --output-path "$export_dir" > /dev/null

  # One line per PNG, in test order: <test>\t<exported file>\t<name>\t<failure>.
  # The suggested name is "<attachment name>_<n>_<uuid>.png"; keep the part a
  # test chose.
  jq -r '.[] | (.testIdentifier // "UI tests") as $test | .attachments | sort_by(.timestamp) | .[]
    | select(.exportedFileName | endswith(".png"))
    | [$test, .exportedFileName,
       (.suggestedHumanReadableName | sub("_[0-9]+_[0-9A-Fa-f-]+\\.png$"; "") | sub("\\.png$"; "")),
       (.isAssociatedWithFailure // false | tostring)] | @tsv' \
    "$export_dir/manifest.json" > "$export_dir/pngs.tsv"

  if [ ! -s "$export_dir/pngs.tsv" ]; then
    echo "The UI tests attached no screenshots."
    return 0
  fi

  local repo_dir prefix="pr-$pr/${sha::7}"
  local auth="AUTHORIZATION: basic $(printf 'x-access-token:%s' "$GH_TOKEN" | base64 | tr -d '\n')"
  local remote="$GITHUB_SERVER_URL/$GITHUB_REPOSITORY.git"

  # Another PR may push between our fetch and push; start over from its
  # commit when that happens.
  local attempt pushed=false
  for attempt in 1 2 3; do
    repo_dir=$(mktemp -d)
    git -C "$repo_dir" init -q
    if git -C "$repo_dir" -c http.extraheader="$auth" fetch -q --depth=1 "$remote" "$BRANCH" 2> /dev/null; then
      git -C "$repo_dir" checkout -q -B "$BRANCH" FETCH_HEAD
    else
      git -C "$repo_dir" checkout -q --orphan "$BRANCH"
    fi

    local test file name failure
    while IFS=$'\t' read -r test file name failure; do
      dest="$repo_dir/$prefix/$(slug "$test")"
      mkdir -p "$dest"
      cp "$export_dir/$file" "$dest/$(slug "$name").png"
    done < "$export_dir/pngs.tsv"

    git -C "$repo_dir" add -A
    git -C "$repo_dir" \
      -c user.name="github-actions[bot]" \
      -c user.email="41898282+github-actions[bot]@users.noreply.github.com" \
      commit -q -m "UI screenshots for #$pr at ${sha::7}"
    if git -C "$repo_dir" -c http.extraheader="$auth" push -q "$remote" "HEAD:$BRANCH"; then
      pushed=true
      break
    fi
    echo "Push attempt $attempt failed; retrying."
  done
  if [ "$pushed" != true ]; then
    echo "::warning::Could not push the UI screenshots to the $BRANCH branch."
    return 0
  fi

  local base_url="$GITHUB_SERVER_URL/$GITHUB_REPOSITORY/blob/$BRANCH/$prefix"
  local run_url="$GITHUB_SERVER_URL/$GITHUB_REPOSITORY/actions/runs/$GITHUB_RUN_ID"
  {
    printf 'UI screenshots for commit `%s` ([run](%s)), from the UI tests that show this PR'"'"'s change.\n' "${sha::7}" "$run_url"
    if [ "$passed" != true ]; then
      printf '\n> [!WARNING]\n> Some of these UI tests failed. Screenshots marked <em>(failure)</em> were taken when a test failed.\n'
    fi
    local current="" column=0
    while IFS=$'\t' read -r test file name failure; do
      if [ "$test" != "$current" ]; then
        [ -z "$current" ] || printf '</tr>\n</table>\n'
        printf '\n#### `%s`\n\n<table>\n<tr>\n' "$test"
        current="$test" column=0
      fi
      if [ "$column" -eq 3 ]; then
        printf '</tr>\n<tr>\n'
        column=0
      fi
      local label
      label=$(html "$name")
      [ "$failure" != true ] || label="$label <em>(failure)</em>"
      printf '<td align="center" valign="top"><img src="%s/%s/%s.png?raw=true" width="250" alt="%s"><br><sub>%s</sub></td>\n' \
        "$base_url" "$(slug "$test")" "$(slug "$name")" "$(html "$name")" "$label"
      column=$((column + 1))
    done < "$export_dir/pngs.tsv"
    printf '</tr>\n</table>\n'
  } > "$comment"
}

# Text safe inside HTML, attribute values included.
html() {
  printf '%s' "$1" | sed -e 's/&/\&amp;/g' -e 's/</\&lt;/g' -e 's/>/\&gt;/g' -e 's/"/\&quot;/g'
}

# A path segment that needs no URL encoding.
slug() {
  printf '%s' "$1" | sed -E 's/[^A-Za-z0-9._-]+/-/g; s/^-+//; s/-+$//'
}

case "${1:-}" in
  tests) shift; tests "$@" ;;
  destination) shift; destination "$@" ;;
  publish) shift; publish "$@" ;;
  *) echo "usage: ui-screenshots tests <test-dir> <test-target> | destination | publish <xcresult> <pr-number> <sha> <tests-passed> <comment-file>" >&2; exit 2 ;;
esac
